# 사전등록 마감 시각 = 이벤트 하루 전 (ISO 8601, KST 오프셋 포함 필수). 타이머가 이 시각까지 센다
VITE_REGISTRATION_END_AT=2026-10-30T23:59:59+09:00

# 개인정보(네이버 id·이메일) 보유 기간 (일). 기본값 없음 — 비우면 빌드가 실패한다
VITE_RETENTION_DAYS=30

# 사전등록 완료 화면의 "카카오톡으로 이벤트 알림 받기" 버튼이 여는 채널 주소. 비우면 빌드가 실패한다
VITE_KAKAO_CHANNEL_URL=https://pf.kakao.com/_xxxxxx

# 비워두면 목업 API를 사용한다(네이버 로그인 없이 흐름 확인). 백엔드가 생기면 base URL을 채운다
# VITE_API_BASE_URL=https://api.desyp.site
# 로컬 백엔드: VITE_API_BASE_URL=http://localhost:8080
